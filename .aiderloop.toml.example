# Copy to .aiderloop.toml in a project and edit. Every field is optional.

[model]
# Ollama name of the model aider writes with (no "ollama/" prefix). Used to
# check its context size before each item.
author = "qwen25-coder-aider"
# Passed to aider as --edit-format (overrides .aider.conf.yml). "diff" is
# the default; "whole" makes the model re-emit every file it edits.
edit_format = "diff"

[validate]
# Built-in syntax checkers, run over the files each item changed.
# Omit to enable "python" and "js-html". "npm-build" runs `npm run build`.
checks = ["python", "js-html"]
# Project-wide gate, always run in full. Shell strings, cwd = project dir.
commands = [".venv/bin/pytest tests/test_fast.py -q"]

[preflight]
# Warn about files this size or larger that aren't in .aiderignore.
max_file_bytes = 262144

[worker]
# Two or more names here runs the loop with that many concurrent workers,
# one per model, instead of --models on the command line every time. Each
# name should be a DIFFERENT model -- see README's "Parallel workers"
# section for why two workers sharing one model gets none of the benefit.
# models = ["qwen25-coder-aider", "qwen2.5-coder:7b"]
